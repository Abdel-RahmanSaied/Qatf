# Copy to .env and fill in. .env is gitignored; this template is not.
# A real environment variable always wins over .env — see qatf/core/dotenv.py

# --- stage 3: which provider picks the clips -------------------------------
# anthropic | openai | kimi | glm | ollama | vllm | openrouter
QATF_LLM_PROVIDER=openrouter
# override the preset's default model
# QATF_LLM_MODEL=
# point a preset at a different host (proxy, self-hosted)
# QATF_LLM_BASE_URL=

# --- provider credentials: set the one matching QATF_LLM_PROVIDER ---------
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# ZHIPU_API_KEY=...

# --- ffmpeg, when it is installed but not on PATH -------------------------
# QATF_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
# QATF_FFPROBE=C:\tools\ffmpeg\bin\ffprobe.exe

# --- API server -----------------------------------------------------------
# QATF_DATA_DIR=qatf-data
# QATF_MEDIA_ROOT=.
# QATF_WORKERS=1
